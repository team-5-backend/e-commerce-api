      // Initial Metric Assignment
      document.getElementById('endpointCount').innerText = endpoints.length
      document.getElementById('moduleCount').innerText = [
        ...new Set(endpoints.map((e) => e.module)),
      ].length

      function resolveRequestBody(endpoint) {
        if (endpoint.request === null || endpoint.request === undefined) return null
        if (typeof endpoint.request === 'string') return examples[endpoint.request] ?? null
        return endpoint.request
      }

      function buildModuleNav() {
        const modules = [...new Set(endpoints.map((e) => e.module))]
        const nav = document.getElementById('sidebarNav')
        let html = `
          <div class="nav-section-title">Overview</div>
          <a href="#overview" class="nav-link active"><span>${iconMap['default']}Overview</span></a>
          <div class="nav-section-title">API Modules</div>
        `
        html += modules
          .map(
            (module) => `
          <a href="#${slugify(module)}" class="nav-link">
            <span>${iconMap[module] || iconMap['default']}${module}</span>
            <span class="count">${endpoints
              .filter((e) => e.module === module)
              .length.toString()
              .padStart(2, '0')}</span>
          </a>
        `,
          )
          .join('')
        nav.innerHTML = html
      }

      function slugify(value) {
        return value
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '')
      }

      function getVisibleEndpoints() {
        const q = document.getElementById('searchInput').value.toLowerCase().trim()
        const method = document.querySelector('.filter-btn.active')?.dataset.method || 'ALL'

        return endpoints.filter((endpoint) => {
          const matchesMethod = method === 'ALL' || endpoint.method === method
          const haystack =
            `${endpoint.module} ${endpoint.method} ${endpoint.path} ${endpoint.description}`.toLowerCase()
          const matchesSearch = !q || haystack.includes(q)
          return matchesMethod && matchesSearch
        })
      }

      function render() {
        const visible = getVisibleEndpoints()
        const grouped = visible.reduce((acc, endpoint) => {
          if (!acc[endpoint.module]) acc[endpoint.module] = []
          acc[endpoint.module].push(endpoint)
          return acc
        }, {})

        const modules = Object.entries(grouped)
        const root = document.getElementById('modules')

        root.innerHTML = modules
          .map(
            ([module, items]) => `
          <div class="module-group" id="${slugify(module)}">
            <div class="module-title">${module}</div>
            ${items
              .map(
                (endpoint) => `
              <details class="route-card" data-method="${endpoint.method}">
                <summary class="route-summary">
                  <div class="route-info">
                    <span class="method-badge method-${endpoint.method.toLowerCase()}">${endpoint.method}</span>
                    <div>
                      <div class="route-path">/api/v1${endpoint.path}</div>
                      <div class="route-desc">${endpoint.description}</div>
                    </div>
                  </div>
                  <div class="route-right">
                    <span class="public-badge">${endpoint.auth}</span><span class="arrow-icon">▼</span>
                  </div>
                </summary>
                <div class="route-body">
                  <div>
                    <span style="font-size: 0.7rem; font-weight: 700; color: var(--text-muted); display: block; margin-bottom: 6px; letter-spacing: 0.5px;">REQUEST</span>
                    <pre>${escapeHtml(JSON.stringify(resolveRequestBody(endpoint), null, 2) || 'null')}</pre>
                    <button class="try-btn" type="button" data-endpoint='${JSON.stringify(endpoint)}'>Try Endpoint</button>
                  </div>
                  <div>
                    <span style="font-size: 0.7rem; font-weight: 700; color: var(--text-muted); display: block; margin-bottom: 6px; letter-spacing: 0.5px;">RESPONSE EXAMPLE</span>
                    <pre class="response-pre">${escapeHtml(JSON.stringify(samples[endpoint.response] || samples.ok, null, 2))}</pre>
                  </div>
                </div>
              </details>
            `,
              )
              .join('')}
          </div>
        `,
          )
          .join('')

        document.querySelectorAll('.try-btn').forEach((btn) => {
          btn.addEventListener('click', () => openTryModal(JSON.parse(btn.dataset.endpoint)))
        })

        bindNav()
      }

      function bindNav() {
        const links = document.querySelectorAll('.nav-link')
        links.forEach((link) => {
          link.addEventListener('click', (e) => {
            e.preventDefault()
            const href = link.getAttribute('href')
            const target = document.getElementById(href.slice(1))
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' })
            links.forEach((l) => l.classList.remove('active'))
            link.classList.add('active')
          })
        })
      }

      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;')
      }

      document.getElementById('searchInput').addEventListener('input', render)

      document.querySelectorAll('.filter-btn').forEach((button) => {
        button.addEventListener('click', () => {
          document.querySelectorAll('.filter-btn').forEach((btn) => btn.classList.remove('active'))
          button.classList.add('active')
          render()
        })
      })

      function openTryModal(endpoint) {
        const dialog = document.getElementById('requestDialog')
        const title = document.getElementById('dialogTitle')
        const urlField = document.getElementById('requestUrl')
        const queryField = document.getElementById('requestQuery')
        const bodyFieldContainer = document.getElementById('bodyFieldContainer')
        const bodyField = document.getElementById('requestBody')
        const resultBox = document.getElementById('resultBox')

        title.textContent = `Try ${endpoint.method} /api/v1${endpoint.path}`
        urlField.value = `${API_BASE}${endpoint.path}`
        queryField.value = endpoint.query || ''

        const request = resolveRequestBody(endpoint)
        if (endpoint.method === 'GET' || endpoint.method === 'DELETE') {
          bodyFieldContainer.style.display = 'none'
          bodyField.value = ''
        } else {
          bodyFieldContainer.style.display = 'block'
          bodyField.value = request ? JSON.stringify(request, null, 2) : ''
        }

        resultBox.style.display = 'none'
        resultBox.textContent = ''

        document.getElementById('sendRequest').onclick = async () => {
          const token = document.getElementById('tokenInput').value.trim()
          const url = `${urlField.value}${queryField.value ? `?${queryField.value}` : ''}`
          const method = endpoint.method
          const headers = {}
          if (token) headers.Authorization = `Bearer ${token}`

          let body = bodyField.value.trim()
          let bodyContent = undefined
          if (body && method !== 'GET' && method !== 'DELETE') {
            headers['Content-Type'] = 'application/json'
            bodyContent = body
          }

          resultBox.style.display = 'block'
          resultBox.textContent = 'Sending request...'

          try {
            const res = await fetch(url, {
              method,
              headers,
              credentials: 'include',
              body: bodyContent,
            })

            const text = await res.text()
            let parsed
            try {
              parsed = JSON.parse(text)
            } catch {
              parsed = text
            }

            resultBox.textContent = `HTTP ${res.status} ${res.statusText}\n\n${typeof parsed === 'string' ? parsed : JSON.stringify(parsed, null, 2)}`
          } catch (error) {
            resultBox.textContent = `Request failed: ${error.message}\n\nEnsure the API server is running and CORS is configured for this page.`
          }
        }

        dialog.showModal()
      }

      document.getElementById('closeDialog').addEventListener('click', () => {
        document.getElementById('requestDialog').close()
      })

      buildModuleNav()
      render()
    </script>
  </body>
