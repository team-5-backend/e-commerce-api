<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-commerce API Documentation</title>
    <style>
        :root {
            --bg-main: #0f172a;
            --bg-sidebar: #1e293b;
            --bg-card: #1e293b;
            --border-color: #334155;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --accent: #10b981;
            --accent-hover: #059669;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* Sidebar Styles */
        aside {
            width: 280px;
            background-color: var(--bg-sidebar);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
        }

        .logo-area {
            padding: 24px;
            font-size: 1.25rem;
            font-weight: bold;
            color: var(--accent);
            border-bottom: 1px solid var(--border-color);
            letter-spacing: 0.5px;
        }

        nav {
            flex: 1;
            padding: 20px 12px;
            overflow-y: auto;
        }

        nav a {
            display: block;
            padding: 12px 16px;
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            border-radius: 8px;
            margin-bottom: 6px;
            transition: all 0.2s ease;
        }

        nav a:hover {
            background-color: rgba(16, 185, 129, 0.1);
            color: var(--accent);
            transform: translateX(4px);
        }

        /* Main Content Area */
        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        header {
            background-color: var(--bg-sidebar);
            border-bottom: 1px solid var(--border-color);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        header h1 {
            font-size: 1.5rem;
            font-weight: 600;
        }

        .badge {
            background-color: rgba(16, 185, 129, 0.15);
            color: var(--accent);
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-family: monospace;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        .container {
            padding: 40px;
            max-width: 1100px;
            margin: 0 auto;
            width: 100%;
        }

        section {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 28px;
            margin-bottom: 30px;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
        }

        section h2 {
            color: var(--accent);
            font-size: 1.35rem;
            margin-bottom: 16px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border-color);
        }

        p {
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 20px;
        }

        /* Tables Styles */
        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            font-size: 0.9rem;
        }

        th {
            background-color: #0f172a;
            color: var(--text-muted);
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 0.05em;
            padding: 14px 16px;
            border-bottom: 2px solid var(--border-color);
        }

        td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
            color: #e2e8f0;
        }

        tr:hover td {
            background-color: rgba(255, 255, 255, 0.02);
        }

        .method {
            font-family: monospace;
            font-weight: bold;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
        }

        .GET { color: #60a5fa; background-color: rgba(96, 165, 250, 0.1); }
        .POST { color: #34d399; background-color: rgba(52, 211, 153, 0.1); }
        .PATCH { color: #fbbf24; background-color: rgba(251, 191, 36, 0.1); }
        .DELETE { color: #f87171; background-color: rgba(248, 113, 113, 0.1); }

        .path {
            font-family: monospace;
            color: #e2e8f0;
        }

        .grid-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-top: 15px;
        }

        .info-card {
            background-color: #0f172a;
            padding: 16px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }

        .info-card span {
            display: block;
            color: var(--text-muted);
            font-size: 0.8rem;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .info-card code {
            color: var(--accent);
            font-family: monospace;
            font-size: 0.95rem;
        }
    </style>
</head>
<body>

    <aside>
        <div class="logo-area">⚡ E-Commerce API</div>
        <nav>
            <a href="#overview">Overview</a>
            <a href="#auth">Authentication</a>
            <a href="#products">Products</a>
            <a href="#carts">Carts</a>
            <a href="#wishlists">Wishlists</a>
            <a href="#orders">Orders</a>
            <a href="#users">Users</a>
            <a href="#admin">Admin Summaries</a>
        </nav>
    </aside>

    <main>
        <header>
            <h1>API Documentation Dashboard</h1>
            <span class="badge">Base: /api/v1</span>
        </header>

        <div class="container">
            <section id="overview">
                <h2>Overview</h2>
                <p>REST API for product browsing, account authentication, cart management, wishlists, and order processing for the e-commerce service.</p>
                <div class="grid-info">
                    <div class="info-card">
                        <span>Local Default</span>
                        <code>http://localhost:3000/api/v1</code>
                    </div>
                    <div class="info-card">
                        <span>Rate Limits</span>
                        <p style="margin: 0; font-size: 0.85rem; color: #cbd5e1;">Global: 100 req/15m<br>Auth: 5 req/15m</p>
                    </div>
                </div>
            </section>

            <section id="auth">
                <h2>Authentication Endpoints</h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Method</th>
                                <th>Path</th>
                                <th>Description</th>
                                <th>Auth</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/auth/login</td><td>Sign in and return an access token</td><td>No</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/auth/register/send-otp</td><td>Send registration OTP to an email</td><td>No</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/auth/verify-otp</td><td>Verify registration OTP and create account</td><td>No</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/auth/forgotpassword/send-otp</td><td>Send reset-password OTP</td><td>No</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/auth/forgotpassword/verify-otp</td><td>Reset password after OTP verification</td><td>No</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/auth/logout</td><td>Revoke current session and clear cookie</td><td>Yes</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/auth/logout-all</td><td>Revoke all sessions for current user</td><td>Yes</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/auth/refresh</td><td>Exchange refresh cookie for access token</td><td>Cookie</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/auth/sessions</td><td>List active sessions for current user</td><td>Yes</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/auth/me</td><td>Get current user profile</td><td>Yes</td></tr>
                            <tr><td><span class="method DELETE">DELETE</span></td><td class="path">/auth/sessions/:sessionId</td><td>Revoke one user session</td><td>Yes</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section id="products">
                <h2>Products Endpoints</h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Method</th>
                                <th>Path</th>
                                <th>Description</th>
                                <th>Auth</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/products/search</td><td>Search active products</td><td>No</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/products</td><td>List active products with filters/pagination</td><td>No</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/products/:id</td><td>Get single active product by ID</td><td>No</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/products/:id/reviews</td><td>List reviews on a product</td><td>No</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/products</td><td>Create a product</td><td>Admin</td></tr>
                            <tr><td><span class="method PATCH">PATCH</span></td><td class="path">/products/:id</td><td>Update a product</td><td>Admin</td></tr>
                            <tr><td><span class="method DELETE">DELETE</span></td><td class="path">/products/:id</td><td>Delete a product</td><td>Admin</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/products/:id/reviews</td><td>Add a customer review</td><td>Authenticated</td></tr>
                            <tr><td><span class="method DELETE">DELETE</span></td><td class="path">/products/:id/reviews/:reviewId</td><td>Delete a product review</td><td>Authenticated</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section id="carts">
                <h2>Carts Endpoints</h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Method</th>
                                <th>Path</th>
                                <th>Description</th>
                                <th>Auth</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/carts</td><td>Get the current user's cart</td><td>Yes</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/carts/items</td><td>Add an item to the cart</td><td>Yes</td></tr>
                            <tr><td><span class="method PATCH">PATCH</span></td><td class="path">/carts/items</td><td>Update a cart item</td><td>Yes</td></tr>
                            <tr><td><span class="method DELETE">DELETE</span></td><td class="path">/carts/items/:id</td><td>Remove one cart item</td><td>Yes</td></tr>
                            <tr><td><span class="method DELETE">DELETE</span></td><td class="path">/carts/clear</td><td>Clear the cart</td><td>Yes</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/carts/coupon</td><td>Apply a coupon</td><td>Yes</td></tr>
                            <tr><td><span class="method DELETE">DELETE</span></td><td class="path">/carts/coupon</td><td>Remove the active coupon</td><td>Yes</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section id="wishlists">
                <h2>Wishlists Endpoints</h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Method</th>
                                <th>Path</th>
                                <th>Description</th>
                                <th>Auth</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/wishlists/my</td><td>Get the current user's wishlist</td><td>Yes</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/wishlists/add/:id</td><td>Add a product to the wishlist</td><td>Yes</td></tr>
                            <tr><td><span class="method DELETE">DELETE</span></td><td class="path">/wishlists/remove/:id</td><td>Remove a product from the wishlist</td><td>Yes</td></tr>
                            <tr><td><span class="method DELETE">DELETE</span></td><td class="path">/wishlists/clear</td><td>Clear the wishlist</td><td>Yes</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section id="orders">
                <h2>Orders Endpoints</h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Method</th>
                                <th>Path</th>
                                <th>Description</th>
                                <th>Auth</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/orders</td><td>Create an order</td><td>Yes</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/orders/my</td><td>List current user's orders</td><td>Yes</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/orders/my/:id</td><td>Get one order for current user</td><td>Yes</td></tr>
                            <tr><td><span class="method PATCH">PATCH</span></td><td class="path">/orders/my/:id/cancel</td><td>Cancel an order</td><td>Yes</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/orders/admin</td><td>List all orders (admin)</td><td>Admin</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/orders/admin/:id</td><td>Get order details by ID (admin)</td><td>Admin</td></tr>
                            <tr><td><span class="method PATCH">PATCH</span></td><td class="path">/orders/admin/:id/status</td><td>Update order status (admin)</td><td>Admin</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/orders/admin/dashboard</td><td>Get admin order dashboard summary</td><td>Admin</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/orders/admin/carts</td><td>Get active carts (admin)</td><td>Admin</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/orders/webhook/stripe</td><td>Stripe webhook endpoint</td><td>Webhook</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/orders/webhook/paypal</td><td>PayPal webhook endpoint</td><td>Webhook</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/orders/webhook/paymob</td><td>Paymob webhook endpoint</td><td>Webhook</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section id="users">
                <h2>Users Endpoints</h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Method</th>
                                <th>Path</th>
                                <th>Description</th>
                                <th>Auth</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/users/all</td><td>List all users (admin)</td><td>Admin</td></tr>
                            <tr><td><span class="method POST">POST</span></td><td class="path">/users/add</td><td>Create user record (admin)</td><td>Admin</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/users/:id</td><td>Get user by ID (admin)</td><td>Admin</td></tr>
                            <tr><td><span class="method PATCH">PATCH</span></td><td class="path">/users/:id</td><td>Update a user</td><td>Authenticated</td></tr>
                            <tr><td><span class="method DELETE">DELETE</span></td><td class="path">/users/:id</td><td>Delete a user (admin)</td><td>Admin</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section id="admin">
                <h2>Admin Summaries</h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Method</th>
                                <th>Path</th>
                                <th>Description</th>
                                <th>Auth</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/admin/dashboard</td><td>Admin dashboard analytics</td><td>Admin</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/admin/carts</td><td>List active carts</td><td>Admin</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/admin/wishlists</td><td>List user wishlists</td><td>Admin</td></tr>
                            <tr><td><span class="method GET">GET</span></td><td class="path">/admin/wishlists/stats</td><td>Top wishlisted products summary</td><td>Admin</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>

</body>
</html>
