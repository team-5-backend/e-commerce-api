<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <title>Store API • Developer Portal</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg-base: #f8fafc;
        --sidebar-bg: #ffffff;
        --card-bg: #ffffff;
        --border-color: rgba(124, 58, 237, 0.18);
        --neon-purple: #7c3aed;
        --neon-cyan: #0891b2;
        --text-main: #0f172a;
        --text-muted: #64748b;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        scroll-behavior: smooth;
      }

      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
        background-color: var(--bg-base);
        color: var(--text-main);
        display: flex;
        height: 100vh;
        overflow: hidden;
      }

      /* Sidebar Styling */
      aside {
        width: 270px;
        background-color: var(--sidebar-bg);
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        height: 100%;
        z-index: 10;
      }

      .brand {
        padding: 24px 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid var(--border-color);
      }

      .brand-icon {
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(6, 182, 212, 0.2));
        border: 1px solid rgba(139, 92, 246, 0.4);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 15px rgba(139, 92, 246, 0.2);
        color: var(--neon-purple);
      }

      .brand-icon .icon {
        width: 20px;
        height: 20px;
      }

      .brand-title h2 {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-main);
      }

      .nav-container {
        flex: 1;
        padding: 20px 16px;
        overflow-y: auto;
      }

      .nav-section-title {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: var(--text-muted);
        margin: 16px 0 8px 12px;
        font-weight: 700;
      }

      .nav-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.82rem;
        font-weight: 500;
        border-radius: 10px;
        margin-bottom: 6px;
        transform: translateX(0);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid transparent;
      }

      .nav-link span:first-child {
        display: flex;
        align-items: center;
        gap: 10px;
        transition: transform 0.3s ease;
      }

      .nav-link .icon {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
      }

      .nav-link .count {
        font-size: 0.7rem;
        background: rgba(15, 23, 42, 0.05);
        padding: 2px 6px;
        border-radius: 6px;
        color: var(--text-muted);
        transition: all 0.3s ease;
      }

      .nav-link:hover {
        background: rgba(124, 58, 237, 0.08);
        color: var(--text-main);
        transform: translateX(6px);
        border-color: rgba(124, 58, 237, 0.25);
      }

      .nav-link:hover span:first-child {
        transform: translateX(3px);
      }

      .nav-link.active {
        background: linear-gradient(135deg, rgba(124, 58, 237, 0.16), rgba(8, 145, 178, 0.1));
        color: #4c1d95;
        border: 1px solid rgba(124, 58, 237, 0.4);
        transform: translateX(8px);
        box-shadow: 0 4px 16px rgba(124, 58, 237, 0.15);
      }

      .nav-link.active .count {
        background: var(--neon-purple);
        color: #fff;
        box-shadow: 0 0 10px rgba(139, 92, 246, 0.5);
      }

      .sidebar-footer {
        padding: 16px 20px;
        border-top: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.75rem;
        color: #16a34a;
      }

      .status-dot {
        width: 8px;
        height: 8px;
        background: #22c55e;
        border-radius: 50%;
        box-shadow: 0 0 8px #22c55e;
      }

      /* Main Content Styling */
      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow-y: auto;
      }

      header {
        padding: 16px 40px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        z-index: 5;
      }

      .header-title h1 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-main);
      }

      .header-title p {
        font-size: 0.75rem;
        color: var(--text-muted);
      }

      .search-box {
        position: relative;
        width: 280px;
      }

      .search-box input {
        width: 100%;
        background: rgba(15, 23, 42, 0.03);
        border: 1px solid var(--border-color);
        padding: 8px 14px 8px 36px;
        border-radius: 10px;
        color: var(--text-main);
        font-size: 0.8rem;
        outline: none;
        transition: all 0.3s;
      }

      .search-box input:focus {
        border-color: var(--neon-purple);
        box-shadow: 0 0 10px rgba(139, 92, 246, 0.2);
      }

      .search-box svg {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        width: 14px;
        height: 14px;
        fill: var(--text-muted);
      }

      .content-wrapper {
        padding: 30px 40px;
        max-width: 1200px;
        margin: 0 auto;
        width: 100%;
      }

      /* Hero Banner */
      .hero-banner {
        background: linear-gradient(135deg, #f5f3ff, #ecfeff);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        overflow: hidden;
        margin-bottom: 30px;
      }

      .hero-text h2 {
        font-size: 2.2rem;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 12px;
        background: linear-gradient(90deg, #1e1b4b, #7c3aed);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .hero-text p {
        color: var(--text-muted);
        font-size: 0.9rem;
        max-width: 600px;
        margin-bottom: 24px;
        line-height: 1.5;
      }

      .hero-tags {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
      }

      .hero-tag {
        background: rgba(15, 23, 42, 0.04);
        border: 1px solid var(--border-color);
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-family: monospace;
        color: #475569;
      }

      /* Rotating Globe Animation */
      .rotating-globe {
        width: 120px;
        height: 120px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .globe-ring {
        position: absolute;
        width: 120px;
        height: 120px;
        border: 2px dashed rgba(139, 92, 246, 0.4);
        border-radius: 100%;
        animation: spin 15s linear infinite;
      }

      .globe-core {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, var(--neon-purple), var(--neon-cyan));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 25px rgba(139, 92, 246, 0.6);
        color: #fff;
      }

      .globe-core .icon {
        width: 26px;
        height: 26px;
        stroke-width: 1.75;
      }

      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }

      /* Metrics Grid */
      .metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 40px;
      }

      .metric-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        padding: 20px;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .metric-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(139, 92, 246, 0.15);
        border-color: rgba(139, 92, 246, 0.4);
      }

      .metric-card .top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--text-muted);
        font-size: 0.8rem;
      }

      .metric-card .top .icon {
        width: 15px;
        height: 15px;
      }

      .metric-card .value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-main);
      }

      /* API Explorer Section */
      .explorer-header {
        margin-bottom: 20px;
      }

      .explorer-header h3 {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 4px;
      }

      .explorer-header p {
        font-size: 0.8rem;
        color: var(--text-muted);
      }

      .filter-buttons {
        display: flex;
        gap: 8px;
        margin-bottom: 20px;
        flex-wrap: wrap;
        align-items: center;
      }

      .filter-btn {
        background: rgba(15, 23, 42, 0.03);
        border: 1px solid var(--border-color);
        padding: 6px 14px;
        border-radius: 8px;
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
      }

      .filter-btn.active,
      .filter-btn:hover {
        background: rgba(124, 58, 237, 0.12);
        color: #6d28d9;
        border-color: var(--neon-purple);
      }

      .token-input {
        flex: 1;
        min-width: 240px;
        background: rgba(15, 23, 42, 0.03);
        border: 1px solid var(--border-color);
        padding: 6px 14px;
        border-radius: 8px;
        color: var(--text-main);
        font-size: 0.75rem;
        outline: none;
        transition: all 0.3s;
      }

      .token-input:focus {
        border-color: var(--neon-purple);
        background: white;
      }

      .module-group {
        margin-bottom: 35px;
      }

      .module-title {
        color: var(--text-main);
        margin-bottom: 14px;
        font-size: 1rem;
        font-weight: 700;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 8px;
      }

      details.route-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        margin-bottom: 12px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      details.route-card:hover {
        border-color: rgba(139, 92, 246, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(139, 92, 246, 0.12);
      }

      details.route-card[open] {
        border-color: var(--neon-purple);
        box-shadow:
          0 10px 35px rgba(139, 92, 246, 0.25),
          0 0 15px rgba(6, 182, 212, 0.15);
        transform: translateY(-3px);
      }

      summary.route-summary {
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        list-style: none;
      }

      summary.route-summary::-webkit-details-marker {
        display: none;
      }

      .route-info {
        display: flex;
        align-items: center;
        gap: 14px;
      }

      .method-badge {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 6px;
        text-align: center;
        min-width: 65px;
      }

      .method-post {
        background: rgba(34, 197, 94, 0.14);
        color: #15803d;
        border: 1px solid rgba(34, 197, 94, 0.35);
      }
      .method-get {
        background: rgba(59, 130, 246, 0.14);
        color: #1d4ed8;
        border: 1px solid rgba(59, 130, 246, 0.35);
      }
      .method-put {
        background: rgba(234, 179, 8, 0.16);
        color: #a16207;
        border: 1px solid rgba(234, 179, 8, 0.35);
      }
      .method-patch {
        background: rgba(168, 85, 247, 0.14);
        color: #7e22ce;
        border: 1px solid rgba(168, 85, 247, 0.35);
      }
      .method-delete {
        background: rgba(239, 68, 68, 0.14);
        color: #b91c1c;
        border: 1px solid rgba(239, 68, 68, 0.35);
      }
      .method-all {
        background: rgba(100, 116, 139, 0.14);
        color: #334155;
        border: 1px solid rgba(100, 116, 139, 0.35);
      }

      .route-path {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-main);
        font-family: monospace;
      }

      .route-desc {
        font-size: 0.78rem;
        color: var(--text-muted);
      }

      .route-right {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .public-badge {
        font-size: 0.65rem;
        background: rgba(15, 23, 42, 0.04);
        padding: 3px 8px;
        border-radius: 6px;
        color: var(--text-muted);
        border: 1px solid var(--border-color);
      }

      .arrow-icon {
        color: var(--text-muted);
        font-size: 0.75rem;
        transition: transform 0.3s ease;
      }

      details[open] .arrow-icon {
        transform: rotate(180deg);
        color: var(--neon-purple);
      }

      .route-body {
        padding: 20px;
        background: var(--bg-base);
        border-top: 1px solid var(--border-color);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        overflow-x: scroll;
      }

      pre {
        background: #f1f5f9;
        border: 1px solid var(--border-color);
        padding: 12px;
        border-radius: 8px;
        font-size: 0.75rem;
        color: #047857;
        overflow-x: auto;
      }

      .response-pre {
        color: #7e22ce;
      }

      .try-btn {
        margin-top: 12px;
        background: var(--neon-purple);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        cursor: pointer;
        font-family: inherit;
        font-weight: 600;
        font-size: 0.75rem;
        transition: background 0.2s;
      }

      .try-btn:hover {
        background: #6d28d9;
      }

      /* Dialog styling adapted for clean theme */
      dialog {
        width: min(760px, calc(100vw - 40px));
        border: 1px solid var(--border-color);
        border-radius: 16px;
        box-shadow: 0 30px 80px rgba(15, 23, 42, 0.35);
        padding: 0;
        font-family: 'Plus Jakarta Sans', sans-serif;
        background: var(--card-bg);
        margin: auto;
      }

      dialog::backdrop {
        background: rgba(15, 23, 42, 0.65);
        backdrop-filter: blur(4px);
      }

      .dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px;
        border-bottom: 1px solid var(--border-color);
      }

      .dialog-header h3 {
        font-size: 1.1rem;
        font-weight: 700;
      }

      .close-btn {
        border: 1px solid var(--border-color);
        background: white;
        border-radius: 8px;
        width: 32px;
        height: 32px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
      }

      .close-btn:hover {
        background: rgba(15, 23, 42, 0.05);
      }

      .dialog-body {
        padding: 20px;
      }

      .field {
        margin-bottom: 16px;
      }

      .field label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 6px;
      }

      .field input,
      .field textarea {
        width: 100%;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.85rem;
        font-family: monospace;
        background: rgba(15, 23, 42, 0.02);
        color: var(--text-main);
        outline: none;
        transition: border-color 0.2s;
      }

      .field input:focus,
      .field textarea:focus {
        border-color: var(--neon-purple);
      }

      .field textarea {
        min-height: 150px;
        resize: vertical;
      }

      .action-row {
        display: flex;
        justify-content: flex-end;
        margin-top: 16px;
      }

      .send-btn {
        background: linear-gradient(135deg, var(--neon-purple), #5b21b6);
        color: white;
        border: 0;
        border-radius: 8px;
        padding: 10px 20px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s;
      }

      .send-btn:hover {
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
      }

      .result-box {
        display: none;
        margin-top: 16px;
        background: #0f172a;
        color: #e2e8f0;
        border-radius: 12px;
        padding: 16px;
        max-height: 300px;
        overflow: auto;
        font-size: 0.75rem;
        line-height: 1.55;
        white-space: pre-wrap;
        font-family: monospace;
      }

      @media (max-width: 900px) {
        .metrics-grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .route-body {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <!-- Sidebar -->
    <aside>
      <div class="brand">
        <div class="brand-icon">
          <svg
            class="icon"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M16 10a4 4 0 0 1-8 0" />
            <path d="M3.103 6.034h17.794" />
            <path
              d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"
            />
          </svg>
        </div>
        <div class="brand-title">
          <h2>Store API</h2>
        </div>
      </div>

      <div class="nav-container" id="sidebarNav">
        <!-- Dynamically generated navigation -->
      </div>

      <div class="sidebar-footer">
        <div class="status-dot"></div>
        <span>API documentation online</span>
      </div>
    </aside>

    <!-- Main Content Area -->
    <main>
      <header>
        <div class="header-title">
          <h1>Store API Reference</h1>
          <p>Interactive developer documentation</p>
        </div>
        <div class="search-box">
          <svg viewBox="0 0 24 24">
            <path
              d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
            />
          </svg>
          <input type="text" id="searchInput" placeholder="Search routes..." />
        </div>
      </header>

      <div class="content-wrapper">
        <!-- Hero Banner -->
        <div class="hero-banner" id="overview">
          <div class="hero-text">
            <h2>Build with the Store API.</h2>
            <p>
              Complete interactive reference for authentication, products, carts, orders, wishlists,
              users and administrative operations. Test endpoints below aligned with public
              contracts.
            </p>
            <div class="hero-tags">
              <span class="hero-tag">/api/v1</span>
              <span class="hero-tag">Authorization: Bearer &lt;token&gt;</span>
              <span class="hero-tag">Refresh Token Cookie</span>
              <span class="hero-tag">JSON</span>
            </div>
          </div>
          <div class="rotating-globe">
            <div class="globe-ring"></div>
            <div class="globe-core">
              <svg
                class="icon"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M16 10a4 4 0 0 1-8 0" />
                <path d="M3.103 6.034h17.794" />
                <path
                  d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"
                />
              </svg>
            </div>
          </div>
        </div>

        <!-- Metrics Cards -->
        <div class="metrics-grid">
          <div class="metric-card">
            <div class="top">
              <span>API Endpoints</span>
              <svg
                class="icon"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
                />
              </svg>
            </div>
            <div class="value" id="endpointCount">0</div>
          </div>
          <div class="metric-card">
            <div class="top">
