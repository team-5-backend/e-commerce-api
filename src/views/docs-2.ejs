        { module: 'Products', method: 'POST', path: '/products/:id/reviews', auth: 'BEARER', description: 'Add a review to a product', request: 'review', response: 'reviews' },
        { module: 'Products', method: 'DELETE', path: '/products/:id/reviews/:reviewId', auth: 'BEARER', description: 'Delete a product review', request: null, response: 'ok' },

        { module: 'Carts', method: 'GET', path: '/carts', auth: 'BEARER', description: 'Get current cart', request: null, response: 'cart' },
        { module: 'Carts', method: 'POST', path: '/carts/items', auth: 'BEARER', description: 'Add items to cart', request: 'addItems', response: 'cartItems' },
        { module: 'Carts', method: 'PATCH', path: '/carts/items', auth: 'BEARER', description: 'Replace item quantities in cart', request: 'addItems', response: 'cartItems' },
        { module: 'Carts', method: 'DELETE', path: '/carts/items/:id', auth: 'BEARER', description: 'Remove one cart item', request: null, response: 'cart' },
        { module: 'Carts', method: 'DELETE', path: '/carts/clear', auth: 'BEARER', description: 'Clear current cart', request: null, response: 'cart' },
        { module: 'Carts', method: 'POST', path: '/carts/coupon', auth: 'BEARER', description: 'Apply a cart coupon', request: 'coupon', response: 'cart' },
        { module: 'Carts', method: 'DELETE', path: '/carts/coupon', auth: 'BEARER', description: 'Remove active coupon', request: null, response: 'cart' },

        { module: 'Wishlists', method: 'GET', path: '/wishlists/my', auth: 'BEARER', description: 'Get current wishlist', request: null, response: 'wishlist' },
        { module: 'Wishlists', method: 'POST', path: '/wishlists/add/:id', auth: 'BEARER', description: 'Add product to wishlist', request: null, response: 'wishlist' },
        { module: 'Wishlists', method: 'DELETE', path: '/wishlists/remove/:id', auth: 'BEARER', description: 'Remove product from wishlist', request: null, response: 'wishlist' },
        { module: 'Wishlists', method: 'DELETE', path: '/wishlists/clear', auth: 'BEARER', description: 'Clear wishlist', request: null, response: 'wishlist' },

        { module: 'Orders', method: 'POST', path: '/orders', auth: 'BEARER', description: 'Create a new order from cart', request: 'orderRequest', response: 'order' },
        { module: 'Orders', method: 'GET', path: '/orders/my', auth: 'BEARER', description: 'List current user orders', request: null, response: 'myOrders', query: 'page=1&limit=10&status=pending' },
        { module: 'Orders', method: 'GET', path: '/orders/my/:id', auth: 'BEARER', description: 'Get one order for current user', request: null, response: 'myOrders' },
        { module: 'Orders', method: 'PATCH', path: '/orders/my/:id/cancel', auth: 'BEARER', description: 'Cancel order', request: null, response: 'myOrders' },
        { module: 'Orders', method: 'GET', path: '/orders/admin', auth: 'ADMIN', description: 'List all orders as admin', request: null, response: 'myOrders', query: 'page=1&limit=10&status=pending&paymentMethod=cash' },
        { module: 'Orders', method: 'GET', path: '/orders/admin/:id', auth: 'ADMIN', description: 'Get order details for admin', request: null, response: 'myOrders' },
        { module: 'Orders', method: 'PATCH', path: '/orders/admin/:id/status', auth: 'ADMIN', description: 'Update order status', request: 'statusUpdate', response: 'myOrders' },
        { module: 'Orders', method: 'GET', path: '/orders/admin/dashboard', auth: 'ADMIN', description: 'Get admin dashboard stats', request: null, response: 'dashboard' },
        { module: 'Orders', method: 'GET', path: '/orders/admin/carts', auth: 'ADMIN', description: 'Get admin carts list', request: null, response: 'ok' },
        { module: 'Orders', method: 'POST', path: '/orders/webhook/stripe', auth: 'WEBHOOK', description: 'Receive Stripe webhook', request: 'webhook', response: 'webhookReceived' },
        { module: 'Orders', method: 'POST', path: '/orders/webhook/paypal', auth: 'WEBHOOK', description: 'Receive PayPal webhook', request: 'webhook', response: 'webhookReceived' },
        { module: 'Orders', method: 'POST', path: '/orders/webhook/paymob', auth: 'WEBHOOK', description: 'Receive Paymob webhook', request: 'webhook', response: 'webhookReceived' },

        { module: 'Users', method: 'GET', path: '/users/all', auth: 'ADMIN', description: 'List all users', request: null, response: 'users' },
        { module: 'Users', method: 'POST', path: '/users/add', auth: 'ADMIN', description: 'Create a new user', request: 'userCreate', response: 'users' },
        { module: 'Users', method: 'GET', path: '/users/:id', auth: 'ADMIN', description: 'Get user by ID', request: null, response: 'users' },
        { module: 'Users', method: 'PATCH', path: '/users/:id', auth: 'BEARER', description: 'Update own or managed user profile', request: { username: 'jane doe', phone: '+15551234567' }, response: 'users' },
        { module: 'Users', method: 'DELETE', path: '/users/:id', auth: 'ADMIN', description: 'Delete a user', request: null, response: 'ok' },

        { module: 'Admin summaries', method: 'GET', path: '/admin/dashboard', auth: 'ADMIN', description: 'Get dashboard analytics', request: null, response: 'dashboard' },
        { module: 'Admin summaries', method: 'GET', path: '/admin/carts', auth: 'ADMIN', description: 'List active carts', request: null, response: 'ok', query: 'page=1&limit=10' },
        { module: 'Admin summaries', method: 'GET', path: '/admin/wishlists', auth: 'ADMIN', description: 'List user wishlists', request: null, response: 'ok', query: 'page=1&limit=10' },
        { module: 'Admin summaries', method: 'GET', path: '/admin/wishlists/stats', auth: 'ADMIN', description: 'Get top wishlisted products', request: null, response: 'ok' }
      ];

      function resolveRequestBody(endpoint) {
        if (endpoint.request === null || endpoint.request === undefined) return null;
        if (typeof endpoint.request === 'string') return examples[endpoint.request] ?? null;
        return endpoint.request;
      }

      function fillPlaceholders(path) {
        return path
          .replace(':sessionId', SESSION_ID)
          .replace(':id', PRODUCT_ID)
          .replace(':reviewId', REVIEW_ID);
      }

      function buildModuleNav() {
        const modules = [...new Set(endpoints.map(e => e.module))];
        const nav = document.getElementById('nav');
        nav.innerHTML = modules.map((module, index) => `
          <a href="#${slugify(module)}" class="${index === 0 ? 'active' : ''}">
            <span>${module}</span>
            <span class="count">${endpoints.filter(e => e.module === module).length}</span>
          </a>
        `).join('');
      }

      function slugify(value) {
        return value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      }

      function getVisibleEndpoints() {
        const q = document.getElementById('searchInput').value.toLowerCase().trim();
        const method = document.querySelector('.tool-btn.active')?.dataset.method || 'ALL';

        return endpoints.filter((endpoint) => {
          const matchesMethod = method === 'ALL' || endpoint.method === method;
          const haystack = `${endpoint.module} ${endpoint.method} ${endpoint.path} ${endpoint.description}`.toLowerCase();
          const matchesSearch = !q || haystack.includes(q);
          return matchesMethod && matchesSearch;
        });
      }

      function render() {
        const visible = getVisibleEndpoints();
        const grouped = visible.reduce((acc, endpoint) => {
          if (!acc[endpoint.module]) acc[endpoint.module] = [];
          acc[endpoint.module].push(endpoint);
          return acc;
        }, {});

        const modules = Object.entries(grouped);
        const root = document.getElementById('modules');
        root.innerHTML = modules.map(([module, items]) => `
          <section class="module" id="${slugify(module)}">
            <div class="module-title">${module}</div>
            ${items.map(endpoint => `
              <details data-method="${endpoint.method}">
                <summary>
                  <div class="route-info">
                    <span class="method-badge ${endpoint.method}">${endpoint.method}</span>
                    <div>
                      <div class="route-path">/api/v1${fillPlaceholders(endpoint.path)}</div>
                      <div class="route-desc">${endpoint.description}</div>
                    </div>
                  </div>
                  <div class="route-meta">
                    <span class="auth-badge">${endpoint.auth}</span>
                    <span class="caret">▼</span>
                  </div>
                </summary>
                <div class="route-body">
                  <div>
                    <span class="panel-label">REQUEST</span>
                    <pre>${escapeHtml(JSON.stringify(resolveRequestBody(endpoint), null, 2) || 'null')}</pre>
                    <button class="try-btn" type="button" data-endpoint='${JSON.stringify(endpoint)}'>Try endpoint</button>
                  </div>
                  <div>
                    <span class="panel-label">RESPONSE EXAMPLE</span>
                    <pre class="response-pre">${escapeHtml(JSON.stringify(samples[endpoint.response] || samples.ok, null, 2))}</pre>
                  </div>
                </div>
              </details>
            `).join('')}
          </section>
        `).join('');

        document.querySelectorAll('.try-btn').forEach((btn) => {
          btn.addEventListener('click', () => openTryModal(JSON.parse(btn.dataset.endpoint)));
        });

        bindNav();
      }

      function bindNav() {
        const links = document.querySelectorAll('#nav a');
        links.forEach((link) => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const target = document.getElementById(link.getAttribute('href').slice(1));
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            links.forEach((l) => l.classList.remove('active'));
            link.classList.add('active');
          });
        });
      }

      function escapeHtml(value) {
        return String(value)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      document.getElementById('searchInput').addEventListener('input', render);

      document.querySelectorAll('.tool-btn').forEach((button) => {
        button.addEventListener('click', () => {
          document.querySelectorAll('.tool-btn').forEach((btn) => btn.classList.remove('active'));
          button.classList.add('active');
          render();
        });
      });

      function openTryModal(endpoint) {
        const dialog = document.getElementById('requestDialog');
        const title = document.getElementById('dialogTitle');
        const urlField = document.getElementById('requestUrl');
        const queryField = document.getElementById('requestQuery');
        const bodyField = document.getElementById('requestBody');
        const resultBox = document.getElementById('resultBox');

        title.textContent = `Try ${endpoint.method} /api/v1${fillPlaceholders(endpoint.path)}`;
        urlField.value = `${API_BASE}${fillPlaceholders(endpoint.path)}`;
        queryField.value = endpoint.query || '';

        const request = resolveRequestBody(endpoint);
        bodyField.value = request ? JSON.stringify(request, null, 2) : '';
        resultBox.style.display = 'none';
        resultBox.textContent = '';

        document.getElementById('sendRequest').onclick = async () => {
          const token = document.getElementById('tokenInput').value.trim();
          const url = `${urlField.value}${queryField.value ? `?${queryField.value}` : ''}`;
          const method = endpoint.method;
          const headers = {};
          if (token) headers.Authorization = `Bearer ${token}`;

          let body = bodyField.value.trim();
          let bodyContent = undefined;
          if (body && method !== 'GET' && method !== 'DELETE') {
            headers['Content-Type'] = 'application/json';
            bodyContent = body;
          }

          resultBox.style.display = 'block';
          resultBox.textContent = 'Sending request...';

          try {
            const res = await fetch(url, {
              method,
              headers,
              credentials: 'include',
              body: bodyContent
            });

            const text = await res.text();
            let parsed;
            try {
              parsed = JSON.parse(text);
            } catch {
              parsed = text;
            }

            resultBox.textContent = `HTTP ${res.status} ${res.statusText}\n\n${typeof parsed === 'string' ? parsed : JSON.stringify(parsed, null, 2)}`;
          } catch (error) {
            resultBox.textContent = `Request failed: ${error.message}\n\nEnsure the API server is running and CORS is configured for this page.`;
          }
        };

        dialog.showModal();
      }

      document.getElementById('closeDialog').addEventListener('click', () => {
        document.getElementById('requestDialog').close();
      });

      buildModuleNav();
      render();
    </script>
  </body>
</html>
