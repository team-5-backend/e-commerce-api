<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Store API • Developer Portal</title>
    <style>
      :root {
        --bg-base: #f8fafc;
        --sidebar-bg: #ffffff;
        --card-bg: #ffffff;
        --border-color: rgba(124, 58, 237, 0.18);
        --neon-purple: #7c3aed;
        --neon-cyan: #0891b2;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --success: #16a34a;
        --danger: #dc2626;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: Inter, 'Segoe UI', sans-serif;
        background: var(--bg-base);
        color: var(--text-main);
        display: flex;
        height: 100vh;
        overflow: hidden;
      }

      aside {
        width: 270px;
        background: var(--sidebar-bg);
        border-right: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      .brand {
        padding: 22px 18px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 800;
        color: var(--neon-purple);
      }

      .brand-mark {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, rgba(124,58,237,.18), rgba(8,145,178,.14));
        border: 1px solid rgba(124,58,237,.4);
      }

      .nav {
        padding: 18px 14px;
        flex: 1;
        overflow-y: auto;
      }

      .nav a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        text-decoration: none;
        color: var(--text-muted);
        font-size: 0.82rem;
        padding: 10px 12px;
        border-radius: 10px;
        margin-bottom: 6px;
        border: 1px solid transparent;
        transition: all 0.2s ease;
      }

      .nav a:hover,
      .nav a.active {
        background: rgba(124, 58, 237, 0.08);
        color: var(--text-main);
        border-color: rgba(124, 58, 237, 0.25);
      }

      .nav .count {
        font-size: 0.68rem;
        background: rgba(15, 23, 42, 0.05);
        border-radius: 6px;
        padding: 2px 6px;
        color: var(--text-muted);
      }

      .nav .active .count {
        background: var(--neon-purple);
        color: white;
      }

      .sidebar-footer {
        padding: 16px 20px;
        border-top: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--success);
        font-size: 0.75rem;
      }

      .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--success);
        box-shadow: 0 0 8px rgba(22, 163, 74, 0.8);
      }

      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
      }

      header {
        padding: 16px 28px;
        border-bottom: 1px solid var(--border-color);
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .header-title h1 {
        font-size: 1rem;
        font-weight: 700;
      }

      .header-title p {
        font-size: 0.75rem;
        color: var(--text-muted);
      }

      .search-wrap {
        position: relative;
        width: min(320px, 42vw);
      }

      .search-wrap input {
        width: 100%;
        border: 1px solid var(--border-color);
        background: rgba(15, 23, 42, 0.03);
        border-radius: 10px;
        padding: 9px 12px 9px 34px;
        color: var(--text-main);
        font-size: 0.8rem;
        outline: none;
      }

      .search-wrap input:focus {
        border-color: var(--neon-purple);
        box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.08);
      }

      .search-icon {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        width: 14px;
        height: 14px;
        opacity: 0.7;
      }

      .content {
        width: min(1200px, 100%);
        margin: 0 auto;
        padding: 30px 28px 50px;
        overflow-y: auto;
      }

      .hero {
        background: linear-gradient(135deg, #f5f3ff, #ecfeff);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        padding: 32px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
      }

      .hero h2 {
        font-size: clamp(1.8rem, 2vw, 2.4rem);
        line-height: 1.1;
        margin-bottom: 12px;
        background: linear-gradient(90deg, #1e1b4b, #7c3aed);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .hero p {
        color: var(--text-muted);
        max-width: 720px;
        line-height: 1.6;
      }

      .hero-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 18px;
      }

      .tag {
        font-size: 0.75rem;
        padding: 6px 10px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        background: rgba(255,255,255,0.6);
        color: #475569;
        font-family: ui-monospace, SFMono-Regular, monospace;
      }

      .toolbar {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 18px;
      }

      .tool-btn {
        border: 1px solid var(--border-color);
        background: rgba(15, 23, 42, 0.02);
        border-radius: 8px;
        padding: 7px 12px;
        cursor: pointer;
        color: var(--text-muted);
        font-size: 0.74rem;
        font-weight: 700;
      }

      .tool-btn.active,
      .tool-btn:hover {
        background: rgba(124, 58, 237, 0.12);
        color: #6d28d9;
        border-color: rgba(124, 58, 237, 0.35);
      }

      .token-input {
        flex: 1;
        min-width: 260px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 8px 12px;
        background: white;
        color: var(--text-main);
      }

      .module {
        margin-bottom: 24px;
      }

      .module-title {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 12px;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 8px;
      }

      details {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        margin-bottom: 12px;
        overflow: hidden;
      }

      details[open] {
        border-color: rgba(124,58,237,.45);
        box-shadow: 0 10px 24px rgba(124,58,237,0.08);
      }

      summary {
        list-style: none;
        cursor: pointer;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      .route-info {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
      }

      .method-badge {
        min-width: 60px;
        text-align: center;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: 800;
      }

      .GET { background: rgba(59,130,246,.12); color: #1d4ed8; border: 1px solid rgba(59,130,246,.22); }
      .POST { background: rgba(34,197,94,.12); color: #15803d; border: 1px solid rgba(34,197,94,.22); }
      .PATCH { background: rgba(168,85,247,.12); color: #7e22ce; border: 1px solid rgba(168,85,247,.22); }
      .DELETE { background: rgba(239,68,68,.12); color: #b91c1c; border: 1px solid rgba(239,68,68,.22); }

      .route-path {
        font-family: ui-monospace, SFMono-Regular, monospace;
        font-size: 0.84rem;
        font-weight: 600;
      }

      .route-desc {
        font-size: 0.75rem;
        color: var(--text-muted);
      }

      .route-meta {
        display: flex;
        align-items: center;
        gap: 10px;
        white-space: nowrap;
      }

      .auth-badge {
        font-size: 0.65rem;
        border: 1px solid var(--border-color);
        border-radius: 5px;
        padding: 3px 7px;
        color: var(--text-muted);
        background: rgba(15,23,42,0.02);
      }

      .caret {
        color: var(--text-muted);
        font-size: 0.78rem;
      }

      .route-body {
        padding: 18px 18px 20px;
        border-top: 1px solid var(--border-color);
        background: #f8fafc;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
      }

      .panel-label {
        display: block;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        margin-bottom: 6px;
      }

      pre {
        background: #f1f5f9;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 12px;
        font-size: 0.72rem;
        line-height: 1.55;
        white-space: pre-wrap;
        word-break: break-word;
        overflow-x: auto;
      }

      .response-pre {
        color: #7c3aed;
      }

      .try-btn {
        margin-top: 10px;
        background: var(--neon-purple);
        color: white;
        border: 0;
        border-radius: 8px;
        padding: 8px 12px;
        cursor: pointer;
        font-weight: 700;
      }

      .try-btn:hover {
        background: #6d28d9;
      }

      dialog {
        width: min(760px, calc(100vw - 40px));
        border: 0;
        border-radius: 16px;
        box-shadow: 0 30px 80px rgba(15, 23, 42, 0.35);
        padding: 0;
      }

      dialog::backdrop {
        background: rgba(15, 23, 42, 0.65);
      }

      .dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 18px 18px 12px;
        border-bottom: 1px solid var(--border-color);
      }

      .dialog-header h3 {
        font-size: 1rem;
      }

      .close-btn {
        border: 1px solid var(--border-color);
        background: white;
        border-radius: 8px;
        width: 32px;
        height: 32px;
        cursor: pointer;
      }

      .dialog-body {
        padding: 18px;
      }

      .field {
        margin-bottom: 12px;
      }

      .field label {
        display: block;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--text-muted);
        margin-bottom: 6px;
      }

      .field input,
      .field textarea {
        width: 100%;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 9px 10px;
        font-size: 0.8rem;
        font-family: ui-monospace, monospace;
      }

      .field textarea {
        min-height: 150px;
        resize: vertical;
      }

      .action-row {
        display: flex;
        justify-content: flex-end;
        margin-top: 12px;
      }

      .send-btn {
        background: var(--neon-purple);
        color: white;
        border: 0;
        border-radius: 8px;
        padding: 9px 14px;
        font-weight: 700;
        cursor: pointer;
      }

      .send-btn:hover {
        background: #6d28d9;
      }

      .result-box {
        display: none;
        margin-top: 14px;
        background: #0f172a;
        color: #e2e8f0;
        border-radius: 8px;
        padding: 12px;
        max-height: 260px;
        overflow: auto;
        font-size: 0.74rem;
        line-height: 1.55;
        white-space: pre-wrap;
      }

      @media (max-width: 860px) {
        .route-body {
          grid-template-columns: 1fr;
        }

        .hero {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <aside>
      <div class="brand">
        <div class="brand-mark">⚡</div>
        <div>Store API</div>
      </div>
      <nav class="nav" id="nav"></nav>
      <div class="sidebar-footer"><span class="status-dot"></span> API documentation online</div>
    </aside>

    <main>
      <header>
        <div class="header-title">
          <h1>Store API Reference</h1>
          <p>Request + response shapes aligned with DOCS.md</p>
        </div>
        <div class="search-wrap">
          <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20L16.65 16.65"></path></svg>
          <input id="searchInput" placeholder="Search routes..." />
        </div>
      </header>

      <div class="content">
        <section class="hero">
          <div>
            <h2>Build with the Store API.</h2>
            <p>Complete documentation for authentication, products, carts, wishlists, orders, users, and admin summaries. Request and response examples below mirror the public contract in <strong>DOCS.md</strong>.</p>
            <div class="hero-tags">
              <span class="tag">/api/v1</span>
              <span class="tag">Authorization: Bearer &lt;token&gt;</span>
              <span class="tag">refreshToken cookie</span>
              <span class="tag">JSON</span>
            </div>
          </div>
        </section>

        <div class="toolbar">
          <input id="tokenInput" class="token-input" placeholder="Optional access token (without Bearer prefix)" />
          <button class="tool-btn active" data-method="ALL">ALL</button>
          <button class="tool-btn" data-method="GET">GET</button>
          <button class="tool-btn" data-method="POST">POST</button>
          <button class="tool-btn" data-method="PATCH">PATCH</button>
          <button class="tool-btn" data-method="DELETE">DELETE</button>
        </div>

        <div id="modules"></div>
      </div>
    </main>

    <dialog id="requestDialog">
      <div class="dialog-header">
        <h3 id="dialogTitle">Try endpoint</h3>
        <button class="close-btn" type="button" id="closeDialog">✕</button>
      </div>
      <div class="dialog-body">
        <div class="field">
          <label for="requestUrl">URL</label>
          <input id="requestUrl" />
        </div>
        <div class="field">
          <label for="requestQuery">Query string</label>
          <input id="requestQuery" placeholder="page=1&limit=10" />
        </div>
        <div class="field">
          <label for="requestBody">JSON body</label>
          <textarea id="requestBody" spellcheck="false" placeholder='{ "email": "customer@example.com", "password": "Password123!" }'></textarea>
        </div>
        <div class="action-row">
          <button class="send-btn" type="button" id="sendRequest">Send request</button>
        </div>
        <pre id="resultBox" class="result-box"></pre>
      </div>
    </dialog>

    <script>
      const API_BASE = '/api/v1';
      const USER_ID = '67a8a6f4a1b23d441b1dd1d0';
      const PRODUCT_ID = '67d5e2b3d9a711c43b1d9a4d';
      const REVIEW_ID = '67d5e2b3d9a711c43b1d9a50';
      const SESSION_ID = '6f1d2d2a-3c3a-4f5e-8c1d-123456789abc';

      const samples = {
        ok: { success: true, message: 'Operation completed successfully.' },
        health: { status: 'OK', timestamp: '2026-09-16T19:00:00.000Z' },
        login: { success: true, message: 'Logged in successfully.', data: { accessToken: '<JWT_ACCESS_TOKEN>' } },
        registerSendOtp: { success: true, message: 'otp sent successfully.' },
        registerVerify: { success: true, message: 'Account created successfully.', data: { accessToken: '<JWT_ACCESS_TOKEN>', _id: USER_ID, username: 'jane doe', email: 'jane@example.com' } },
        forgotSendOtp: { success: true, message: 'If an account exists, a password reset code has been sent to the email address provided.' },
        forgotVerify: { success: true, message: 'Password reset successfully.', data: { _id: USER_ID, username: 'jane doe', email: 'jane@example.com', accessToken: '<JWT_ACCESS_TOKEN>' } },
        logout: { success: true, message: 'Logged out successfully.' },
        refresh: { success: true, message: 'Token refreshed successfully.', data: { accessToken: '<NEW_JWT_ACCESS_TOKEN>' } },
        sessions: { success: true, message: 'Active sessions retrieved successfully.', data: [{ sessionId: SESSION_ID, ip: '127.0.0.1', userAgent: 'Mozilla/5.0', createdAt: '2026-09-16T19:00:00.000Z' }] },
        me: { success: true, message: 'User profile retrieved successfully.', data: { _id: USER_ID, username: 'jane doe', email: 'jane@example.com', role: 'customer', isVerified: true } },
        products: { success: true, message: 'Products retrieved successfully.', data: { products: [{ _id: PRODUCT_ID, name: 'Wireless Headphones', slug: 'wireless-headphones', shortDescription: 'Noise cancelling bluetooth headphones', description: 'Premium wireless headphones.', price: 129.99, discountPrice: 99.99, stock: 25, sku: 'WH-2201', images: [{ public_id: 'products/abc123', url: 'https://example.com/image.jpg' }], category: 'electronics', subcategory: 'audio', brand: 'AudioMax', tags: ['bluetooth', 'audio'], averageRating: 4.8, numReviews: 21, featured: true, isActive: true }], pagination: { page: 1, limit: 10, total: 1, pages: 1 } } },
        productById: { success: true, message: 'Product retrieved successfully.', data: { _id: PRODUCT_ID, name: 'Wireless Headphones', price: 129.99, discountPrice: 99.99, stock: 25, category: 'electronics', images: [{ public_id: 'products/abc123', url: 'https://example.com/image.jpg' }], averageRating: 4.8, numReviews: 21, isActive: true } },
        reviews: { success: true, message: 'Reviews retrieved successfully', data: { reviews: [{ _id: REVIEW_ID, user: { _id: USER_ID, username: 'jane doe' }, rating: 5, comment: 'Great sound quality.' }], pagination: { page: 1, limit: 10, total: 1, pages: 1 } } },
        productCreate: { success: true, message: 'Product created successfully', data: { _id: PRODUCT_ID, name: 'Wireless Headphones', price: 129.99, stock: 25, category: 'electronics', images: [{ public_id: 'products/abc123', url: 'https://example.com/image.jpg' }] } },
        productUpdate: { success: true, message: 'Product updated successfully', data: { _id: PRODUCT_ID, name: 'Wireless Headphones - Updated', price: 119.99, images: [{ public_id: 'products/abc123', url: 'https://example.com/image.jpg' }] } },
        cart: { success: true, message: 'Cart retrieved successfully', data: { _id: '67d5e2b3d9a711c43b1da00', user: USER_ID, items: [], discountAmount: 0 } },
        cartItems: { success: true, message: 'Items added to cart successfully', data: { _id: '67d5e2b3d9a711c43b1da00', items: [{ product: PRODUCT_ID, quantity: 2, price: 99.99 }], discountAmount: 0 } },
        wishlist: { success: true, message: 'Wishlist retrieved successfully', data: { _id: '67d5e2b3d9a711c43b1da10', user: USER_ID, products: [{ _id: PRODUCT_ID, name: 'Wireless Headphones' }] } },
        order: { success: true, message: 'Order created successfully', data: { order: { _id: '67d5e2b3d9a711c43b1da20', paymentMethod: 'cash', paymentStatus: 'pending', status: 'pending', subtotal: 199.98, shippingFee: 50, tax: 28, discount: 0, totalPrice: 277.98, items: [] } } },
        myOrders: { success: true, message: 'Orders fetched successfully', data: { orders: [{ _id: '67d5e2b3d9a711c43b1da20', status: 'pending', totalPrice: 277.98 }], pagination: { page: 1, limit: 10, totalOrders: 1, totalPages: 1 } } },
        users: { success: true, message: 'Users retrieved successfully.', data: [{ _id: USER_ID, username: 'jane doe', email: 'jane@example.com', role: 'customer', isVerified: true }] },
        dashboard: { success: true, message: 'Dashboard analytics retrieved successfully', data: { revenue: { total: 12500, currentMonth: 2000, lastMonth: 1800, growthPercentage: 11.11 }, ordersByStatus: [{ _id: 'delivered', count: 12 }], topProducts: [{ name: 'Wireless Headphones', unitsSold: 10, revenue: 999.9 }], last7Days: [{ _id: '2026-09-16', dailyRevenue: 200, dailyOrders: 2 }], recentOrders: [], totalCustomers: 25 } },
        webhookReceived: { received: true }
      };

      const examples = {
        login: { email: 'customer@example.com', password: 'Password123!' },
        register: { username: 'jane doe', email: 'jane@example.com', password: 'Password123!', phone: '+15551234567' },
        otp: { email: 'jane@example.com', otp: '123456' },
        reset: { email: 'jane@example.com', otp: '123456', newPassword: 'NewPassword123!' },
        review: { rating: 5, comment: 'Great sound quality.' },
        addItems: { items: [{ productId: PRODUCT_ID, quantity: 2 }] },
        coupon: { code: 'SAVE10' },
        orderRequest: { shippingAddress: { country: 'Egypt', city: 'Cairo', address: '10 Example Street', postalCode: '11511' }, paymentMethod: 'cash', customerNote: 'Please call on delivery.' },
        userCreate: { username: 'jane doe', email: 'jane@example.com', password: 'Password123!', phone: '+15551234567', role: 'customer', addresses: { country: 'Egypt', city: 'Cairo', address: '10 Example Street', postalCode: '11511' } },
        statusUpdate: { status: 'confirmed', adminNote: 'Payment verified.' },
        webhook: { event: 'checkout.session.completed' }
      };

      const endpoints = [
        { module: 'Authentication', method: 'POST', path: '/auth/login', auth: 'PUBLIC', description: 'Authenticate user and return an access token', request: 'login', response: 'login' },
        { module: 'Authentication', method: 'POST', path: '/auth/register/send-otp', auth: 'PUBLIC', description: 'Send registration OTP', request: 'register', response: 'registerSendOtp' },
        { module: 'Authentication', method: 'POST', path: '/auth/register/verify-otp', auth: 'PUBLIC', description: 'Verify registration OTP and create account', request: 'otp', response: 'registerVerify' },
        { module: 'Authentication', method: 'POST', path: '/auth/forgotpassword/send-otp', auth: 'PUBLIC', description: 'Send reset-password OTP', request: { email: 'jane@example.com' }, response: 'forgotSendOtp' },
        { module: 'Authentication', method: 'POST', path: '/auth/forgotpassword/verify-otp', auth: 'PUBLIC', description: 'Reset password after OTP verification', request: 'reset', response: 'forgotVerify' },
        { module: 'Authentication', method: 'POST', path: '/auth/logout', auth: 'BEARER', description: 'Logout current session', request: null, response: 'logout' },
        { module: 'Authentication', method: 'POST', path: '/auth/logout-all', auth: 'BEARER', description: 'Logout all devices', request: null, response: 'ok' },
        { module: 'Authentication', method: 'POST', path: '/auth/refresh', auth: 'COOKIE', description: 'Refresh current access token', request: null, response: 'refresh' },
        { module: 'Authentication', method: 'GET', path: '/auth/sessions', auth: 'BEARER', description: 'List active sessions for current user', request: null, response: 'sessions' },
        { module: 'Authentication', method: 'GET', path: '/auth/me', auth: 'BEARER', description: 'Get current user profile', request: null, response: 'me' },
        { module: 'Authentication', method: 'DELETE', path: '/auth/sessions/:sessionId', auth: 'BEARER', description: 'Revoke one session', request: null, response: 'ok' },

